      "typeVersion": 2.4,
      "position": [
        -64,
        256
      ]
    },
    {
      "parameters": {
        "url": "=https://world.openfoodfacts.org/api/v2/product/{{ String($(\"Recibir solicitud nutrition-check\").item.json.body.barcode).trim() }}.json",
