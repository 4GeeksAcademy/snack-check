            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "is-numeric",
              "leftValue": "={{ String($json.body.barcode).trim() }}",
              "rightValue": "^\\d+$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9f705304-35a8-477d-89cf-d01a94af41ed",
      "name": "Comprobar que el código es numérico",
